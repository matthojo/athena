# dependencies / build output
node_modules
app/dist/
site/dist/
.netlify/

# auto-generated by `netlify dev`'s local Deno runtime for Edge Functions —
# pins Netlify's internal bootstrap module hashes, not a lockfile we maintain
deno.lock

# env / secrets — never commit real credentials
.env
.env.*
!.env.example

# decrypted scratch copies of sensitive content — must never be committed
*.decrypted
*.decrypted.*
/tmp-decrypted/

# OS cruft
.DS_Store

# screenshots from npm run shots (extension) and scripts/connector-marks-sheet.mjs
/shots/

# on-demand Obsidian export output — regenerated via `npm run export:obsidian`
export/obsidian-vault/
