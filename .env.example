# Athena — environment variables
#
# Copy to `.env` for local `netlify dev` use. In production these are set as
# Netlify environment variables (site settings or `netlify env:set`), never
# committed — see .gitignore.

# Shared bearer token gating both the MCP server (netlify/functions/mcp.ts)
# and the REST API (netlify/functions/api.ts). Generate one with:
#   openssl rand -hex 32
MCP_BEARER_TOKEN=

# The Athena PWA's own login password (netlify/edge-functions/site-auth.ts) —
# this is what you type into the browser login page, not the bearer token
# above. Pick your own value; this isn't meant to be machine-generated.
SITE_PASSWORD=

# Signs the browser session cookie issued after a correct SITE_PASSWORD.
# Deliberately a separate secret from MCP_BEARER_TOKEN — see SECURITY.md
# section 6. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Netlify DB (Postgres + pgvector) connection string. Set automatically by
# Netlify once the database is provisioned for this site — do not set this
# manually, and do not put a real value here.
NETLIFY_DB_URL=

# Embeddings provider API key, for semantic search over note_chunks
# (lib/db.ts's searchNotesBySimilarity / upsertNoteChunk). Not wired up to any
# function yet — semantic search is a v2 feature pending a choice of
# embeddings provider (OpenAI, Voyage, etc).
# EMBEDDINGS_API_KEY=

# Encryption at rest for your content (notes, people, events, to-dos, …):
# lib/data-box.ts, SECURITY.md §11. 32 random bytes as 64 hex characters, set
# for the PRODUCTION context only, so deploy previews can't read their copy of
# the database. Netlify won't show it again, so keep your own copy (README
# "Encryption at rest" has a command that also saves it to your Keychain):
#   netlify env:set ATHENA_DATA_KEY "<key>" --secret --context production --scope functions
# Losing it loses the data. Leave it unset locally: without it, data that's
# already encrypted shows as "Encrypted — open on …" and text writes are refused.
# ATHENA_DATA_KEY=
# Only while rotating: the old key(s), so values sealed under them still open
# while the encrypt-data function re-seals everything under the new key.
# ATHENA_DATA_KEY_PREVIOUS=

# Web Push (reminders + the 07:30 briefing push; netlify/functions/reminders.ts,
# lib/push.ts). Generate a pair once, locally, with:
#   npx web-push generate-vapid-keys
# then set them as Netlify env vars (see README "Reminders"). Without them the
# briefing note is still written and pushes are skipped with a log line.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Connectors (netlify/lib/connectors/, the app's Connectors page). Seals every
# connector credential — OAuth access/refresh tokens, API keys — with
# AES-256-GCM before it's stored (lib/secret-box.ts). 32 random bytes as 64 hex
# characters; set it as a Netlify secret, never commit it:
#   openssl rand -hex 32
# Changing it later makes stored sign-ins unreadable: every account then needs
# signing in again. See SECURITY.md §9.
CONNECTOR_ENCRYPTION_KEY=

# Collections call Claude through Netlify AI Gateway, which injects
# ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL into functions automatically once the
# site has had a production deploy on a credit-based plan — nothing to set.
# To use your own Anthropic key instead, set ANTHROPIC_API_KEY (as a secret).
# ANTHROPIC_API_KEY=

# Optional: the model collections use (default claude-sonnet-5-5). Use
# claude-opus-5-5 for the subtlest extraction, claude-haiku-5-5 for the lowest cost.
# ATHENA_COLLECTOR_MODEL=
