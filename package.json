{
  "name": "athena",
  "version": "1.4.0",
  "private": true,
  "description": "Personal second brain: Netlify DB + MCP server + offline-first PWA.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "netlify dev",
    "dev:app": "vite --config app/vite.config.ts",
    "build": "tsx scripts/check-preview-secrets.ts && vite build --config app/vite.config.ts",
    "preview": "vite preview --config app/vite.config.ts",
    "export:obsidian": "tsx scripts/export-obsidian.ts",
    "site:build": "tsx scripts/build-site.ts",
    "site:preview": "vite preview --outDir site/dist --port 4174",
    "test": "tsx --test 'lib/**/*.test.ts' 'app/src/**/*.test.ts' 'netlify/**/*.test.ts' 'scripts/**/*.test.ts'",
    "check:licences": "tsx scripts/check-licences.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p app",
    "test:db": "ATHENA_DATA_KEY=2222222222222222222222222222222222222222222222222222222222222222 tsx --test --test-concurrency=1 'lib/*.db.test.ts' 'netlify/**/*.db.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@mozilla/readability": "^0.6.0",
    "@netlify/blobs": "^10.7.13",
    "@netlify/database": "^1.0.0",
    "@netlify/server": "^0.1.6",
    "@tiptap/core": "^3.32.3",
    "@tiptap/extension-mention": "^3.32.3",
    "@tiptap/extension-placeholder": "^3.32.3",
    "@tiptap/extension-table": "^3.32.3",
    "@tiptap/extension-task-item": "^3.32.3",
    "@tiptap/extension-task-list": "^3.32.3",
    "@tiptap/markdown": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "@tiptap/suggestion": "^3.32.3",
    "@typesafe-ai/sdk": "^0.7.0",
    "d3-force": "^3.0.1",
    "linkedom": "^0.18.12",
    "marked": "^17.0.6",
    "pg": "^8.13.0",
    "sharp": "^0.35.5",
    "unpdf": "^2.1.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.0",
    "@types/d3-force": "^3.0.10",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
